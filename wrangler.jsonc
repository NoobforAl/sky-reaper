// SKY REAPER — Cloudflare Workers config (Workers Static Assets + Hono API + D1).
// Keys verified against node_modules/wrangler/config-schema.json (wrangler 4.164).
// See docs/DEPLOY.md for the full deploy walkthrough.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sky-reaper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",

  "assets": {
    // Vite build output (npm run build).
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (no matching file) are answered with /index.html (SPA).
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; every other request is served by the
    // asset layer directly (free, fast). Cache headers come from public/_headers.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sky-reaper",
      // PLACEHOLDER. Run `npx wrangler d1 create sky-reaper` and paste the
      // printed database_id here before `npm run db:migrate:remote` / deploy.
      // Local dev (`wrangler dev`, `npm run db:migrate:local`) works with the placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
