{
  "name": "sky-reaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run typecheck:worker && wrangler deploy",
    "build:arvan": "npm run build && node scripts/arvan/build-bundle.mjs dist dist-arvan/bundle.js",
    "deploy:arvan": "npm run build:arvan && node scripts/arvan/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "dev:edge": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply sky-reaper --local",
    "db:migrate:remote": "wrangler d1 migrations apply sky-reaper --remote",
    "test": "playwright test",
    "cf-typegen": "wrangler types",
    "art": "node scripts/art/build.mjs"
  },
  "dependencies": {
    "kaplay": "^3001.0.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "hono": "^4.13.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0",
    "zod": "^4.6.7"
  }
}
